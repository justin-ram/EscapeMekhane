  m_biomePrefab: {fileID: 2454901207045131480, guid: 5d28da65ad55adc4899180bb885715b9, type: 3}
  m_info:
    m_title: Flower Patches
    m_description: Scatters patches of wild flowers within each biome bounds.
    m_usageGuide: Spawns two flower patch biomes that share one placement graph.
      Move each biome and edit its anchors to shape where the flowers grow, then
      duplicate any of them to scatter more patches around your scene. Every patch
      reads the same graph, so shaping it updates them all at once. In the graph,
      tweak the noise and thin out nodes to control patch size and density, or swap
      the detail template to spawn your own plant.
    m_screenshot: {fileID: 2800000, guid: 717e48469d325394a9d900454b84a254, type: 3}
  m_sortingNumber: 100
