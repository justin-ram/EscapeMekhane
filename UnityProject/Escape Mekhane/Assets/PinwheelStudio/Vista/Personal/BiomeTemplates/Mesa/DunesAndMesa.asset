  m_Script: {fileID: 11500000, guid: be4def07ea272974b9312b6e17e82fd3, type: 3}
  m_Name: DunesAndMesa
  m_EditorClassIdentifier: 
  m_biomePrefab: {fileID: 6359630705898813852, guid: 08ba382dd2c77cb4dbd33575811a5754, type: 3}
  m_info:
    m_title: Mesa
    m_description: Raise a flat topped mesa with steep, stratified cliffs standing
      over a surrounding field of sand dunes.
    m_usageGuide: 'Creates two paired biomes, a flat topped mesa with terraced cliff
      walls and an eroded base, sitting inside a broad dune flat that fills the ground
      around it.

      The mesa reads the detailed shape of its biome mask, so move
      the biome and edit its anchors to sculpt the plateau outline, while the dunes
      fill the remaining area and fade into neighboring biomes through the falloff.

      The
      falloff distance strongly shapes the base of the mesa, so keep the falloff
      area larger than the inner base anchors. A wider falloff spreads the base into
      a natural talus slope, while a falloff that is too small leaves the base steep
      and looking fake.

      A strong starting point for desert badlands, canyon
      country, or arid tableland scenes where you want bold elevation and a sandy
      surround from the start.'
    m_screenshot: {fileID: 2800000, guid: 30615afdb8a76494dba057c7feee9c6a, type: 3}
    m_documentationUrl: https://docs.pinwheelstud.io/vista/templates/mesa
  m_sortingNumber: 2
