  m_stickyNoteData:
  - typeInfo:
      fullName: Pinwheel.Vista.Graph.StickyNote
    jsonData: '{"m_groupId":"U89QXBIE","m_id":"2X4KTFVN","m_title":"","m_contents":"Mesa
      shape is driven by your biome mask (biome anchors).\nTo have this input binded
      properly, you must open the graph using the biome''s inspector.\nDouble click
      the graph asset in Project folder renders this mask blank.\n\nIn practice,
      the host biome should use a Biome Mask Graph (default provided one) to make
      this mask softer with some noisy detail.","m_fontSize":0,"m_theme":0,"m_position":{"serializedVersion":"2","x":-614.4000244140625,"y":1437.5999755859375,"width":207.20001220703126,"height":208.0}}'
    version: 1
  - typeInfo:
      fullName: Pinwheel.Vista.Graph.StickyNote
    jsonData: '{"m_groupId":"1Y248ASB","m_id":"VQTDMCUB","m_title":"","m_contents":"The
      Curve make its cliff steeper, mimicking how they look in real life.\n\nThen,
      warp it with high frequency noise to add detail to the edges.","m_fontSize":0,"m_theme":0,"m_position":{"serializedVersion":"2","x":-188.0,"y":1502.4000244140625,"width":353.6000061035156,"height":100.0}}'
    version: 1
  - typeInfo:
      fullName: Pinwheel.Vista.Graph.StickyNote
    jsonData: '{"m_groupId":"H2BY2BRX","m_id":"444SRU18","m_title":"","m_contents":"Crank
      up \"In Mid\" and the mesa base start to appear.\nTone down \"Out High\" to
      lower the overall shape, so we can add more detail to the top later.","m_fontSize":0,"m_theme":0,"m_position":{"serializedVersion":"2","x":409.6000061035156,"y":1437.5999755859375,"width":130.39999389648438,"height":132.0}}'
    version: 1
  - typeInfo:
      fullName: Pinwheel.Vista.Graph.StickyNote
    jsonData: '{"m_groupId":"H2BY2BRX","m_id":"HJ5QK5BA","m_title":"","m_contents":"Add
      random detail to it","m_fontSize":0,"m_theme":0,"m_position":{"serializedVersion":"2","x":665.5999755859375,"y":1304.7999267578125,"width":151.20001220703126,"height":100.0}}'
    version: 1
  - typeInfo:
      fullName: Pinwheel.Vista.Graph.StickyNote
    jsonData: '{"m_groupId":"H2BY2BRX","m_id":"FRYNVJWK","m_title":"","m_contents":"Mask
      out the \"top\" part. Should be:\nMin = Levels.OutHigh - 0.01\nMax = 1","m_fontSize":0,"m_theme":0,"m_position":{"serializedVersion":"2","x":836.0,"y":1588.0,"width":304.0,"height":100.0}}'
    version: 1
  - typeInfo:
      fullName: Pinwheel.Vista.Graph.StickyNote
    jsonData: '{"m_groupId":"H2BY2BRX","m_id":"M78F7C3D","m_title":"","m_contents":"Mask
      out the \"bottom\" part. Should be:\nMin = 0.01\nMax = Levels.OutHigh*0.5","m_fontSize":0,"m_theme":0,"m_position":{"serializedVersion":"2","x":838.4000244140625,"y":1784.7999267578125,"width":314.4000244140625,"height":100.0}}'
    version: 1
  - typeInfo:
      fullName: Pinwheel.Vista.Graph.StickyNote
    jsonData: '{"m_groupId":"H2BY2BRX","m_id":"DTG7D7ZA","m_title":"","m_contents":"Just
